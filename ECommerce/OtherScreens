@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun AllCategoriesScreen(onBackClick: () -> Unit) {
    val categories = listOf(
        Category("Shoes", "https://img.icons8.com/color/96/sneakers.png"),
        Category("Beauty", "https://img.icons8.com/color/96/lipstick.png"),
        Category("Women", "https://img.icons8.com/color/96/dress.png"),
        Category("Men", "https://img.icons8.com/color/96/t-shirt.png"),
        Category("Kids", "https://img.icons8.com/color/96/teddy-bear.png"),
        Category("Bags", "https://img.icons8.com/color/96/handbag.png"),
        Category("Watch", "https://img.icons8.com/color/96/watch.png"),
        Category("Sports", "https://img.icons8.com/color/96/trophy.png")
    )

    Scaffold(
        topBar = {
            TopAppBar(
                title = { Text("All Categories", fontWeight = FontWeight.Bold) },
                navigationIcon = {
                    IconButton(onClick = onBackClick) {
                        Icon(Icons.Default.ArrowBack, contentDescription = "Back")
                    }
                }
            )
        }
    ) { padding ->
        LazyVerticalGrid(
            columns = GridCells.Fixed(3),
            modifier = Modifier.padding(padding).fillMaxSize(),
            contentPadding = PaddingValues(16.dp),
            horizontalArrangement = Arrangement.spacedBy(16.dp),
            verticalArrangement = Arrangement.spacedBy(24.dp)
        ) {
            items(categories) { category ->
                Column(horizontalAlignment = Alignment.CenterHorizontally) {
                    Box(
                        modifier = Modifier
                            .size(80.dp)
                            .clip(CircleShape)
                            .background(MaterialTheme.colorScheme.surfaceVariant),
                        contentAlignment = Alignment.Center
                    ) {
                        AsyncImage(model = category.icon, contentDescription = null, modifier = Modifier.size(40.dp))
                    }
                    Spacer(modifier = Modifier.height(8.dp))
                    Text(category.name, fontSize = 14.sp, fontWeight = FontWeight.Medium)
                }
            }
        }
    }
}

