/**
 * An Interactive Weather Application.
 * Includes: Navigation, Animations, Box/Row/Column, and Responsive Buttons.
 */
@Composable
fun WeatherApp() {
    val navController = rememberNavController()
    NavHost(navController = navController, startDestination = "home") {
        composable("home") { WeatherHomeScreen(navController) }
        composable("details") { WeatherDetailsScreen(navController) }
    }
}

// --- Home Screen ---
@Composable
fun WeatherHomeScreen(navController: NavController) {
    val skyBlue = Color(0xFF4FC3F7)
    val deepBlue = Color(0xFF0288D1)

    Column(
        modifier = Modifier
            .fillMaxSize()
            .background(Brush.verticalGradient(listOf(skyBlue, deepBlue)))
            .padding(24.dp),
        horizontalAlignment = Alignment.CenterHorizontally
    ) {
        Spacer(modifier = Modifier.height(60.dp))
        
        Text("Mumbai, IN", color = Color.White, fontSize = 28.sp, fontWeight = FontWeight.Bold)
        Text("Friday, 12 June", color = Color.White.copy(alpha = 0.8f), fontSize = 16.sp)

        Spacer(modifier = Modifier.height(40.dp))

        // Animated Sun Icon
        val infiniteTransition = rememberInfiniteTransition(label = "Sun")
        val rotation by infiniteTransition.animateFloat(
            initialValue = 0f,
            targetValue = 360f,
            animationSpec = infiniteRepeatable(tween(10000, easing = LinearEasing)),
            label = "Rotation"
        )

        Box(contentAlignment = Alignment.Center) {
            Box(modifier = Modifier.size(180.dp).background(Color(0xFFFFD54F).copy(alpha = 0.2f), CircleShape))
            Icon(
                Icons.Default.WbSunny,
                contentDescription = null,
                tint = Color(0xFFFFEB3B),
                modifier = Modifier.size(120.dp).rotate(rotation)
            )
        }

        Spacer(modifier = Modifier.height(20.dp))
        Text("32°C", color = Color.White, fontSize = 72.sp, fontWeight = FontWeight.Black)
        Text("Mostly Sunny", color = Color.White, fontSize = 20.sp)

        Spacer(modifier = Modifier.weight(1f))

        // Responsive Navigation Button
        Button(
            onClick = { navController.navigate("details") },
            modifier = Modifier.fillMaxWidth().height(56.dp),
            colors = ButtonDefaults.buttonColors(containerColor = Color.White),
            shape = RoundedCornerShape(16.dp)
        ) {
            Text("VIEW HOURLY FORECAST", color = deepBlue, fontWeight = FontWeight.Bold)
            Spacer(modifier = Modifier.width(8.dp))
            Icon(Icons.Default.ArrowForward, contentDescription = null, tint = deepBlue)
        }
        
        Spacer(modifier = Modifier.height(40.dp))
    }
}

// --- Details Screen ---
@Composable
fun WeatherDetailsScreen(navController: NavController) {
    val darkSky = Color(0xFF263238)
    val lightGray = Color(0xFFF5F5F5)

    Column(
        modifier = Modifier
            .fillMaxSize()
            .background(darkSky)
            .padding(24.dp)
    ) {
        Row(verticalAlignment = Alignment.CenterVertically) {
            IconButton(onClick = { navController.popBackStack() }) {
                Icon(Icons.Default.ArrowBack, contentDescription = null, tint = Color.White)
            }
            Text("Hourly Forecast", color = Color.White, fontSize = 20.sp, fontWeight = FontWeight.Bold)
        }

        Spacer(modifier = Modifier.height(30.dp))

        // Hourly List using LazyRow
        val hours = listOf("1 PM", "2 PM", "3 PM", "4 PM", "5 PM", "6 PM", "7 PM")
        LazyRow(horizontalArrangement = Arrangement.spacedBy(16.dp)) {
            items(hours) { hour ->
                HourlyItem(hour)
            }
        }

        Spacer(modifier = Modifier.height(40.dp))

        // Responsive Stat Grid (Column + Row)
        Text("Details", color = Color.White, fontWeight = FontWeight.Bold, fontSize = 18.sp)
        Spacer(modifier = Modifier.height(16.dp))
        
        Row(modifier = Modifier.fillMaxWidth()) {
            StatCard(label = "Humidity", value = "65%", icon = Icons.Default.WaterDrop, modifier = Modifier.weight(1f))
            Spacer(modifier = Modifier.width(16.dp))
            StatCard(label = "Wind", value = "12 km/h", icon = Icons.Default.Air, modifier = Modifier.weight(1f))
        }
        
        Spacer(modifier = Modifier.height(16.dp))
        
        Row(modifier = Modifier.fillMaxWidth()) {
            StatCard(label = "UV Index", value = "High", icon = Icons.Default.BrightnessHigh, modifier = Modifier.weight(1f))
            Spacer(modifier = Modifier.width(16.dp))
            StatCard(label = "Visibility", value = "10 km", icon = Icons.Default.RemoveRedEye, modifier = Modifier.weight(1f))
        }
    }
}

@Composable
fun HourlyItem(hour: String) {
    var isSelected by remember { mutableStateOf(false) }
    val bgColor by animateColorAsState(if (isSelected) Color(0xFF4FC3F7) else Color.White.copy(alpha = 0.1f))

    Box(
        modifier = Modifier
            .width(80.dp)
            .clip(RoundedCornerShape(20.dp))
            .background(bgColor)
            .clickable { isSelected = !isSelected }
            .padding(16.dp),
        contentAlignment = Alignment.Center
    ) {
        Column(horizontalAlignment = Alignment.CenterHorizontally) {
            Text(hour, color = if (isSelected) Color.White else Color.LightGray, fontSize = 12.sp)
            Spacer(modifier = Modifier.height(8.dp))
            Icon(Icons.Default.Cloud, contentDescription = null, tint = Color.White, modifier = Modifier.size(24.dp))
            Spacer(modifier = Modifier.height(8.dp))
            Text("28°", color = Color.White, fontWeight = FontWeight.Bold)
        }
    }
}

@Composable
fun StatCard(label: String, value: String, icon: ImageVector, modifier: Modifier = Modifier) {
    Card(
        modifier = modifier,
        colors = CardDefaults.cardColors(containerColor = Color.White.copy(alpha = 0.05f)),
        shape = RoundedCornerShape(20.dp)
    ) {
        Column(modifier = Modifier.padding(16.dp)) {
            Icon(icon, contentDescription = null, tint = Color(0xFF4FC3F7), modifier = Modifier.size(24.dp))
            Spacer(modifier = Modifier.height(12.dp))
            Text(label, color = Color.LightGray, fontSize = 12.sp)
            Text(value, color = Color.White, fontWeight = FontWeight.Bold, fontSize = 16.sp)
        }
    }
}
