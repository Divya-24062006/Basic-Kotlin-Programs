import retrofit2.converter.gson.GsonConverterFactory
import retrofit2.http.GET

/**
 * Normal Fake Store version (Non-MVVM, all logic in one file).
 */
class MainActivity : ComponentActivity() {
    private val TAG = "LifeCycle Demo"

    @OptIn(ExperimentalMaterial3Api::class)
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        Log.d(TAG, "On create Called")
        enableEdgeToEdge()
        setContent {
            FirstAppTheme {
                Scaffold(
                    modifier = Modifier.fillMaxSize(),
                    topBar = {
                        CenterAlignedTopAppBar(
                            title = { Text("Fake Store") }
                        )
                    }
                ) { innerPadding ->
                    ProductListScreen(modifier = Modifier.padding(innerPadding))
                }
            }
        }
    }
}

@Composable
fun ProductListScreen(modifier: Modifier = Modifier) {
    var products by remember { mutableStateOf<List<ProductItemData>>(emptyList()) }
    var isLoading by remember { mutableStateOf(true) }

    // Direct API call in the UI (Non-MVVM)
    LaunchedEffect(Unit) {
        try {
            products = RetrofitClientSimple.apiService.getProducts()
            isLoading = false
        } catch (e: Exception) {
            isLoading = false
        }
    }

    Box(modifier = modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
        if (isLoading) {
            CircularProgressIndicator()
        } else {
            LazyColumn(
                modifier = Modifier.fillMaxSize(),
                contentPadding = PaddingValues(16.dp),
                verticalArrangement = Arrangement.spacedBy(16.dp)
            ) {
                items(products) { product ->
                    ProductCard(product)
                }
            }
        }
    }
}

@Composable
fun ProductCard(product: ProductItemData) {
    Card(
        modifier = Modifier.fillMaxWidth(),
        elevation = CardDefaults.cardElevation(defaultElevation = 4.dp)
    ) {
        Row(modifier = Modifier.padding(16.dp).height(120.dp)) {
            AsyncImage(
                model = product.image,
                contentDescription = null,
                modifier = Modifier.width(100.dp).fillMaxHeight(),
                contentScale = ContentScale.Fit
            )
            Spacer(modifier = Modifier.width(16.dp))
            Column(verticalArrangement = Arrangement.SpaceBetween, modifier = Modifier.fillMaxHeight()) {
                Text(product.title, fontWeight = FontWeight.Bold, maxLines = 2, overflow = TextOverflow.Ellipsis)
                Text("⭐ ${product.rating.rate}", fontSize = 12.sp, color = Color.Gray)
                Text("$${product.price}", fontWeight = FontWeight.ExtraBold, color = MaterialTheme.colorScheme.primary)
            }
        }
    }
}

// Data models and Retrofit setup all in this file
data class RatingSimple(val rate: Float, val count: Int)
data class ProductItemData(
    val id: Int,
    val title: String,
    val price: Float,
    val image: String,
    val rating: RatingSimple
)

interface ApiServiceSimple {
    @GET("products")
    suspend fun getProducts(): List<ProductItemData>
}

object RetrofitClientSimple {
    private const val BASE_URL = "https://fakestoreapi.com/"
    val apiService: ApiServiceSimple by lazy {
        Retrofit.Builder()
            .baseUrl(BASE_URL)
            .addConverterFactory(GsonConverterFactory.create())
            .build()
            .create(ApiServiceSimple::class.java)
    }
}
